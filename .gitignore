# Node artifacts
node_modules/

# npm package artifacts
*.tgz

# Keep CLI source file, ignore generated files in bin/
bin/*
!bin/
!bin/sdcorejs-agent.mjs

# Common generated outputs in bin/
bin/**/*.js
bin/**/*.cjs
bin/**/*.map
bin/**/*.d.ts
bin/**/*.d.ts.map
bin/**/*.tsbuildinfo

# Claude Code local user settings (track .claude/skills/, README.md, sync-skills.sh)
.claude/settings.json
.claude/settings.local.json

# SDCoreJS diagnostic/local-only artifacts. Durable specs, plans, summaries,
# handoffs, ledgers, documentation, memories, and owned backlogs remain visible.
# Legacy live-session checkpoints are ignored for backward compatibility. New
# workflows must not create or update them.
.sdcorejs/tasks/current-session.md
.sdcorejs/tasks/sessions/
.sdcorejs/cache/
.sdcorejs/caches/
.sdcorejs/codegraph-cache/
.sdcorejs/storage/
.sdcorejs/temp/
.sdcorejs/tmp/
.sdcorejs/trace/
.sdcorejs/traces/
.sdcorejs/**/*auth-state*
.sdcorejs/**/*browser-state*
.sdcorejs/**/*storage-state*
.sdcorejs/**/*.har
.sdcorejs/**/*.trace
.sdcorejs/**/*.webm
