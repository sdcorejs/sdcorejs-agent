# Enforce LF line endings for all text files Git tracks.
#
# Without this, Windows contributors with core.autocrlf=true end up with
# CRLF blobs in some commits and LF blobs in others. The sync-skills check
# compares generated output byte-for-byte, so line-ending drift can produce
# false-positive "out of sync" reports.
#
# text eol=lf instructs Git to normalize line endings to LF in the stored blob
# and check files out as LF in the working tree.

*               text=auto
*.md            text eol=lf
*.json          text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
*.sh            text eol=lf
*.ts            text eol=lf
*.tsx           text eol=lf
*.js            text eol=lf
*.mjs           text eol=lf
*.cjs           text eol=lf
*.ps1           text eol=crlf
*.cmd           text eol=crlf
*.bat           text eol=crlf
*.html          text eol=lf
*.scss          text eol=lf
*.css           text eol=lf
*.mdc           text eol=lf
*.astro         text eol=lf
*.tpl           text eol=lf
*.txt           text eol=lf
*.conf          text eol=lf
*.Dockerfile    text eol=lf
Dockerfile      text eol=lf
*.example       text eol=lf
.env.example    text eol=lf
.gitattributes  text eol=lf
.gitignore      text eol=lf
.clinerules     text eol=lf
LICENSE         text eol=lf
plugin/hooks/session-start text eol=lf

# Binary - never normalize.
*.png           binary
*.jpg           binary
*.jpeg          binary
*.gif           binary
*.svg           text eol=lf
*.ico           binary
*.woff          binary
*.woff2         binary
