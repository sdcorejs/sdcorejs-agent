{
  "name": "sdcorejs-agent",
  "version": "0.5.1",
  "description": "Portable SDLC skill pack for AI coding agents, with generated mirrors for Claude Code, Codex, Cursor, and Copilot.",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sdcorejs/sdcorejs-agent.git"
  },
  "bugs": {
    "url": "https://github.com/sdcorejs/sdcorejs-agent/issues"
  },
  "homepage": "https://github.com/sdcorejs/sdcorejs-agent#readme",
  "type": "module",
  "files": [
    "_refs",
    "skills",
    "CLAUDE.md",
    "AGENTS.md",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "sdcorejs",
    "sdlc-agent",
    "claude-code",
    "github-copilot",
    "codex",
    "angular",
    "nestjs",
    "nextjs"
  ],
  "engines": {
    "node": ">=18"
  },
  "packageManager": "npm@10.9.2",
  "scripts": {
    "test": "npm run test:e2e",
    "test:e2e": "node --test test/e2e/*.test.mjs",
    "test:e2e:phase1": "node --test test/e2e/skill-pack-runner.test.mjs",
    "test:e2e:phase2": "node --test test/e2e/cli-adapters.test.mjs",
    "test:e2e:phase3": "node --test test/e2e/entrypoint-smoke.test.mjs",
    "test:e2e:phase4": "node --test test/e2e/golden-target-app.test.mjs",
    "check:text-hygiene": "node scripts/check-text-hygiene.mjs",
    "sync:skills": "node scripts/sync-skills.mjs",
    "check:skills": "node scripts/sync-skills.mjs --check",
    "clean:skills": "node scripts/sync-skills.mjs --clean",
    "sync:skills:ps": "powershell -ExecutionPolicy Bypass -File .claude/sync-skills.ps1",
    "check:skills:ps": "powershell -ExecutionPolicy Bypass -File .claude/sync-skills.ps1 -check",
    "clean:skills:ps": "powershell -ExecutionPolicy Bypass -File .claude/sync-skills.ps1 -clean",
    "check:audit": "npm audit --omit=dev",
    "check:site:audit": "npm --prefix site audit --omit=dev",
    "build:site": "npm --prefix site run build",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "lefthook": "^1.7.0"
  }
}
